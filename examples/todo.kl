# ============================================================
# todo.kl — 待办清单应用逻辑（平台无关，无 main）
# ------------------------------------------------------------
# 同一份逻辑被 todo_native.kl 与 todo_web.kl 两个薄入口复用。
# 展示三种能力：input 事件实时捕获 value、submit（表单回车）、列表动态渲染。
#
# 对外 API：
#   fn todo_init() void    # 清空状态
#   fn todo_view() cstring # 渲染回调
#
# 状态：固定容量 32 项（Kaula 无全局数组，用 if 链槽位存取，
# 写法与 backend_webview.kl 事件环形队列一致）。
# ============================================================
import std.io
import std.string
import std.container
import "../webui/element.kl"
import "../webui/app.kl"
import "../webui/bridge.kl"

