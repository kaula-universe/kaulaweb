# ============================================================
# todo_native.kl — 待办清单 native 薄入口（webview 后端）
# ------------------------------------------------------------
# 应用逻辑全部在 todo.kl，本文件仅负责：
#   注册渲染回调 -> 注册平台函数 -> 注入取证 JS -> 启动窗口。
#
# 取证：webview_backend_add_init 注入自动化 JS：
#   1.5s 给输入框设值「写框架」并 dispatch input 事件
#   2.2s 点击「添加」（button click 同时触发 form submit，实际入列 2 项）
#   2.9s 点击「完成」（切换删除线）
#   3.3s 快照断言：列表内出现「写框架」且带 line-through（记 R=1）
#   3.8s/4.3s 点击「删除」两次（删完 2 项）
#   4.8s 断言：R==1 且「写框架」已不在列表，经 kaula_event(kid=0,type=probe) 回传
# 日志：examples\todo_native.log（业务侧）+ kw_backend.log（后端侧）
# ============================================================
import std.io
import std.string
import std.container
import "../webui/element.kl"
import "../webui/app.kl"
import "../webui/bridge.kl"
import "../webui/shell.kl"
import "../backends/backend_webview.kl"
import "todo.kl"
import webview

# 入口日志统一经模块单句柄落盘（避免双 FILE* 同文件互踩）
fn tn_log(string s) void {
    todo_log(s)
}

# eval 平台函数包装：每次 bridge_refresh 的 kw_render 帧下发都经此落盘
fn tn_eval(cstring js) void {
    void() vp = as<void()>(js)
    if (vp == null) {
        tn_log("[entry] eval frame: js is NULL (framework alloc failure?)")
        return
    }
    string s = std.string.string_create(js)
    string head = std.string.string_substring(s, 0, 20)
    tn_log(std.string.string_concat(std.string.string_create("[entry] eval frame len="), std.string.string_create_from_int(std.string.string_length(s))))
    tn_log(std.string.string_concat(std.string.string_create("[entry] eval head: "), head))
    wv_eval(js)
}

# 取证断言回传 handler：PASS/FAIL 由注入 JS 读 #app innerHTML 判定后回传
fn tn_on_probe(cstring payload) void {
    string s = std.string.string_create(payload)
    tn_log(std.string.string_concat(std.string.string_create("[entry] probe: "), s))
    if (std.string.string_equals(s, "PASS")) {
        tn_log("[entry] ASSERT PASS: add/toggle(line-through)/delete 状态转移全通且列表已清空")
    } else {
        tn_log(std.string.string_concat(std.string.string_create("[entry] ASSERT FAIL: "), s))
    }
}

# 取证专用 view 包装：先建一个不入树的占位元素绑定 probe（首个绑定
# 恒为 kid=0，分发只查注册表不查 DOM），再复用应用 view
fn tn_view() cstring {
    int probe_anchor = kw_div()
    kw_on(probe_anchor, "probe", as<cstring>(tn_on_probe))
    return todo_view()
}

fn main() {
    todo_init()
    string log_path = std.string.string_create("todo_native.log")
    todo_open_log(log_path.ptr)
    tn_log("[entry] start")

    app_set_render(as<cstring>(tn_view))
    bridge_register(as<cstring>(wv_show), as<cstring>(tn_eval))

    # 自动测试注入：
    #   1.5s 设值「写框架」并 dispatch input 事件（验证 input 捕获）
    #   2.2s 点「添加」（refresh，验证列表渲染；click+submit 双触发入列 2 项）
    #   2.9s 点「完成」（refresh，验证删除线样式）
    #   3.3s 快照：列表含「写框架」且带 line-through 则 R=1
    #   3.8s/4.3s 点「删除」两次（refresh x2，验证删除转移）
    #   4.8s 断言 R==1 且列表已无「写框架」，经 kaula_event 回传 PASS/FAIL
    string auto_js = std.string.string_create("function F(t){var b=document.querySelectorAll('button');for(var i=0;i<b.length;i++){if(b[i].textContent.trim()==t)return b[i]}}var R=0;function P(){var h=document.getElementById('app').innerHTML;var v=(R&&h.indexOf('写框架')<0)?'PASS':'FAIL';if(window.kaula_event)window.kaula_event('{\"kid\":\"0\",\"type\":\"probe\",\"value\":\"'+v+'\"}')}setTimeout(function(){var i=document.querySelector('input');i.value='写框架';i.dispatchEvent(new Event('input',{bubbles:true}))},1500);setTimeout(function(){F('添加').click()},2200);setTimeout(function(){F('完成').click()},2900);setTimeout(function(){if(document.querySelector('[style*=line-through]'))R=1},3300);setTimeout(function(){F('删除').click()},3800);setTimeout(function(){F('删除').click()},4300);setTimeout(P,4800);")
    cstring aj = auto_js.ptr
    webview_backend_add_init(aj)

    webview_backend_start("Kaula Todo", 640, 520)
    kw_start()
    tn_log("[entry] kw_start done, first frame delivered; entering run loop")

    webview_backend_run()
    tn_log("[entry] run exited")
}
