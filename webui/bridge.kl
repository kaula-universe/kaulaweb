# ============================================================
# bridge.kl — Kaula WebUI 框架核心：桥协议与渲染管线
# ------------------------------------------------------------
# 平台无关。Platform 抽象：后端注册两个函数指针
#   G_SHOW_HTML —— 整页下发 HTML（首帧）
#   G_EVAL_JS   —— 在页面执行 JS（后续帧 / 任意脚本）
#
# 事件协议（JS -> native）：
#   window.kaula_event('{"kid":"N","type":"click","value":"..."}')
#   native 后端 bind 回解开包 webview 数组包装后调 kw_event；
#   WASM 后端 shim 直接调 kw_event。
#
# 渲染管线：
#   首帧  bridge_show_html(完整页面: 基础 CSS + #app + shell.js)
#   后续  bridge_eval_js("kw_render('<转义后的 #app 内容>')
# ============================================================
import std.io
import std.string
import std.json
import "types.kl"
import "element.kl"
import "app.kl"
import "shell.kl"

# ---------- 事件种类 ADT（仅本文件内部使用） ----------
# kaulac 实测：enum 不能出现在函数签名（codegen bug），故只作局部建模；
# 收益：kw_wv_event_cb 的高频 tick 过滤与分发走 match，避免逐个 string_equals
enum EvKind {
    Click,
    Input,
    Change,
    Submit,
    Tick,
    Other
}

# 字符串 -> EvKind（同文件内调用，enum 局部返回安全）
fn ev_kind_of(string typ) EvKind {
    EvKind k = EvKind.Other
    match typ {
        "click" => { k = EvKind.Click },
        "input" => { k = EvKind.Input },
        "change" => { k = EvKind.Change },
        "submit" => { k = EvKind.Submit },
        "tick" => { k = EvKind.Tick },
        _ => { k = EvKind.Other }
    }
    return k
}

type PlatformFn = void(cstring) void;

PlatformFn G_SHOW_HTML
PlatformFn G_EVAL_JS
bool G_FIRST = true

# ---------- Platform 注册与包装 ----------
# 函数指针以 cstring 承载传递（as<cstring>(函数名)），见 element.kl 头部注释
export fn bridge_register(cstring show_fn, cstring eval_fn) void {
    G_SHOW_HTML = as<PlatformFn>(show_fn)
    G_EVAL_JS = as<PlatformFn>(eval_fn)
}

export fn bridge_show_html(string html) void {
    if (G_SHOW_HTML == null) {
        return
    }
    cstring p = html.ptr
    G_SHOW_HTML(p)
}

export fn bridge_eval_js(string js) void {
    if (G_EVAL_JS == null) {
        return
    }
    cstring p = js.ptr
    G_EVAL_JS(p)
}

# ---------- 最小 JSON 字段提取 ----------
# 使用 std.json 标准库（JsonValue 经 void() 承接，见 kw_json_parse_event 注）
# JSON 协议字段名（String 变量：std.json extern 形参为 String 值结构体，
# 直接传字面量生成的是 char*，ABI 不符；局部声明提升到函数顶层）
string G_JK_KID = "kid"
string G_JK_TYPE = "type"
string G_JK_VALUE = "value"

export fn kw_json_get(string json, string key) string {
    void() root = std.json.json_parse(json)
    if (root == null) {
        return std.string.string_create("")
    }
    if (std.json.json_is_object(root) == 0) {
        std.json.json_destroy(root)
        return std.string.string_create("")
    }
    void() val = std.json.json_object_get(root, key)
    if (val == null || std.json.json_is_string(val) == 0) {
        std.json.json_destroy(root)
        return std.string.string_create("")
    }
    string result = std.string.string_copy(std.json.json_get_string(val))
    std.json.json_destroy(root)
    return result
}

# ---------- JSON 批量字段提取（单次解析，避免重复解析开销） ----------
# ParsedEvent 定义于 types.kl（跨文件 struct 实测可用）
# JsonValue 以 void() 承接：std 限定类型名在局部声明处会原样泄漏进 C
# （unknown type name），而 json_* 系列 extern 均以指针传参，void* ABI 兼容
export fn kw_json_parse_event(string json) ParsedEvent {
    ParsedEvent result = { .kid = -1, .typ = "", .val = "", .ok = false }

    void() root = std.json.json_parse(json)
    if (root == null) {
        return result
    }
    if (std.json.json_is_object(root) == 0) {
        std.json.json_destroy(root)
        return result
    }

    # 提取 kid（协议兼容 string/number 两种形态）
    void() kid_val = std.json.json_object_get(root, G_JK_KID)
    if (kid_val == null) {
        std.json.json_destroy(root)
        return result
    }
    int kid_num = -1
    if (std.json.json_is_string(kid_val) != 0) {
        kid_num = as<int>(std.string.string_to_int(std.json.json_get_string(kid_val)))
    } else if (std.json.json_is_number(kid_val) != 0) {
        kid_num = as<int>(std.json.json_get_number(kid_val))
    } else {
        std.json.json_destroy(root)
        return result
    }
    result.kid = kid_num

    # 提取 type
    void() type_val = std.json.json_object_get(root, G_JK_TYPE)
    if (type_val != null && std.json.json_is_string(type_val) != 0) {
        result.typ = std.string.string_copy(std.json.json_get_string(type_val))
    }

    # 提取 value
    void() value_val = std.json.json_object_get(root, G_JK_VALUE)
    if (value_val != null && std.json.json_is_string(value_val) != 0) {
        result.val = std.string.string_copy(std.json.json_get_string(value_val))
    }

    result.ok = true
    std.json.json_destroy(root)
    return result
}

# 兼容入口：单字段读取（内部仍走单次解析路径的封装）
export fn kw_json_has(string json, string key) bool {
    void() root = std.json.json_parse(json)
    if (root == null) {
        return false
    }
    bool has = false
    if (std.json.json_is_object(root) != 0) {
        void() val = std.json.json_object_get(root, key)
        has = val != null
    }
    std.json.json_destroy(root)
    return has
}

# ---------- 统一事件入口 ----------
# json 形如 {"kid":"3","type":"input","value":"abc"}
# Task #20（内存确定性）：payload 首次落地用 string_create_global 拷入
# 长寿命幸存段。kw_event 无 #[no_kmm]，编译器包 KMM 作用域：旧版
# string_create(json) 的载荷随 kw_event 返回 scope_pop 回卷，handler 内
# 跨调用持有的引用（如 backend_wasm 的 G_NAME）全靠 alloc_auto 慢路径
# 偶然落幸存段才"能用"；现改为确定性长活。不加 #[no_kmm]：它会把
# 全部解析/渲染临时分配也永久留在池内（泄漏式），长寿命拷贝是改动最小、
# 语义最清晰的确定性方案。native 侧（wv_event_cb -> kw_wv_drain 同步调
# 入）仅略增 survivor 占用，语义安全。
# 性能优化：使用 kw_json_parse_event 单次解析，避免多次调用 kw_json_get 重复解析
export fn kw_event(cstring json) void {
    string s = std.string.string_create_global(json)
    ParsedEvent ev = kw_json_parse_event(s)
    if (!ev.ok) {
        return
    }
    # EvKind 分类：高频 tick 与普通事件走同一分发入口，
    # 分类结果供后续按种类做差异化处理（如 tick 跳过日志）
    EvKind kind = ev_kind_of(ev.typ)
    if (kind == EvKind.Other && std.string.string_is_empty(ev.typ)) {
        return
    }
    kw_dispatch_event(ev.kid, ev.typ, ev.val)
}

# ---------- JS 字符串字面量转义 ----------
# 把 html 包成合法的 JS 单行字符串字面量（含首尾双引号）
#
# 两遍扫描 + 一次定长分配（string_realloc）+ string_set_char_at 逐字填充：
# 逐字符 concat 是 O(n²) 分配量，而 KMM V4 全局池 offset 单调递增、
# 作用域回卷仅复用 thread heap——编译器按 AST 静态估算池容量，一帧视图的
# 逐字符 churn 即可耗尽池导致 string_concat 返回 NULL。StringBuilder 类型
# 未注册进 sema 不可用，两遍法是当前编译器下的 O(n) 方案。
fn kw_js_quote(string s) string {
    # 全部局部提升到函数顶层（块内声明触发 KMM 作用域回卷）
    size_t n = std.string.string_length(s)
    size_t need = n + 2
    size_t i = 0
    size_t j = 0
    char c = '\0'
    string out = std.string.string_create("")
    while (i < n) {
        c = std.string.string_char_at(s, i)
        if (c == '\\') {
            need = need + 1
        } else if (c == '"') {
            need = need + 1
        } else if (c == '\n') {
            need = need + 1
        } else if (c == '\r') {
            need = need + 1
        }
        i = i + 1
    }
    out = std.string.string_realloc(out, need)
    # realloc 失败返回 {.len=need,.ptr=NULL}，而 string_set_char_at
    # 只查 index<len 不查 ptr——不判空即向 NULL 写入。此时返回空串，
    # 由 kw_send 检测后跳过本帧。
    if (out.ptr == null) {
        return std.string.string_create("")
    }
    std.string.string_set_char_at(out, j, '"')
    j = j + 1
    i = 0
    while (i < n) {
        c = std.string.string_char_at(s, i)
        if (c == '\\') {
            std.string.string_set_char_at(out, j, '\\')
            j = j + 1
            std.string.string_set_char_at(out, j, '\\')
        } else if (c == '"') {
            std.string.string_set_char_at(out, j, '\\')
            j = j + 1
            std.string.string_set_char_at(out, j, '"')
        } else if (c == '\n') {
            std.string.string_set_char_at(out, j, '\\')
            j = j + 1
            std.string.string_set_char_at(out, j, 'n')
        } else if (c == '\r') {
            std.string.string_set_char_at(out, j, '\\')
            j = j + 1
            std.string.string_set_char_at(out, j, 'r')
        } else {
            std.string.string_set_char_at(out, j, c)
        }
        j = j + 1
        i = i + 1
    }
    std.string.string_set_char_at(out, j, '"')
    return out
}

# ---------- 异常日志落盘 ----------
# 函数名带 bridge 前缀：非 export 函数与 app.kl 同编入一个 C 翻译单元，
# 同名（如 kw_log_error）会 redefinition。
# （std.logging 实测未纳入 kaulac 自动链接，链接期 undefined symbol）
fn kw_bridge_log(string msg) void {
    void() f = std.io.file_open("kw_bridge.log", "a")
    if (f == null) {
        return
    }
    std.io.file_write(f, msg.ptr, std.string.string_length(msg))
    string nl = std.string.string_create("\n")
    std.io.file_write(f, nl.ptr, 1)
    std.io.file_flush(f)
    std.io.file_close(f)
}

# ---------- 页面组装 ----------
fn kw_base_css() string {
    return "*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui,'Segoe UI',sans-serif;background:#10141a;color:#e8eaed;line-height:1.5}#app{max-width:860px;margin:0 auto;padding:24px}button{cursor:pointer;font:inherit}input,textarea,select{font:inherit}"
}

# 完整页面：基础 CSS + #app 容器 + shell.kl 的 JS 胶水
export fn kw_page(string inner) string {
    string html = std.string.string_create("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>")
    html = html + kw_base_css()
    html = html + "</style></head><body><div id=\"app\">"
    html = html + inner
    html = html + "</div><script>"
    html = html + kw_shell_js()
    html = html + "</script></body></html>"
    return html
}

# ---------- 渲染管线 ----------
# js/page/quoted 提升到函数顶层声明：分支内声明会触发 KMM 作用域回卷，
# 下发给后端回调的字符串缓冲可能在回调拷贝前被卷入可复用区。
fn kw_send(string inner) void {
    string js = std.string.string_create("")
    string page = std.string.string_create("")
    string quoted = std.string.string_create("")
    if (G_FIRST) {
        # 仅当平台函数已注册（实际下发成功）才翻转首帧标志，
        # 否则平台函数未注册时首帧永久丢失。
        if (G_SHOW_HTML != null) {
            G_FIRST = false
            page = kw_page(inner)
            bridge_show_html(page)
        }
    } else {
        quoted = kw_js_quote(inner)
        # KMM 池耗尽时 kw_js_quote 返回空串（realloc 失败 ptr=NULL）：
        # 跳过本帧 eval 并记日志，避免下发 "kw_render()" 非法脚本。
        if (std.string.string_is_empty(quoted)) {
            kw_bridge_log("[kaula-webui] kw_send: quote failed (pool exhausted?), frame skipped")
            return
        }
        js = std.string.string_create("kw_render(")
        js = js + quoted
        js = js + ")"
        bridge_eval_js(js)
    }
}

# 渲染当前视图并下发（首帧 show_html，后续 eval kw_render）
export fn bridge_render() void {
    kw_send(app_render_html())
}

# 状态变更后的刷新入口：清空注册表 -> 重新 render -> 下发
export fn bridge_refresh() void {
    kw_send(app_refresh())
}

# 一键启动：初始化框架（注册表 + 事件钩子）并渲染首帧
# 调用前用户须已 app_set_render(...) 与 bridge_register(...)
export fn kw_start() void {
    kw_init()
    bridge_render()
}
