// ============================================================
// WebUI Framework - Elements Module
// Virtual DOM element construction and HTML rendering
// ============================================================

import std.string
import std.container
import "styles.kl"

// ==================== HTML Attribute Struct ====================

struct HtmlAttribute {
    name: string,
    value: string
}

// ==================== Event Handler Struct ====================

struct EventHandler {
    event_name: string,      // "click", "submit", etc.
    action: string           // JS action or URL endpoint
}

// ==================== Element Type Enum ====================

enum ElementKind {
    TagNode,         // Normal HTML tag with children
    TextNode,        // Pure text content
    RawHtmlNode,     // Raw HTML string (unescaped)
    ComponentNode    // Component placeholder
}

// ==================== Element Class ====================

class Element {
    kind: ElementKind

    // For TagNode:
    tag: string              // e.g. "div", "button"
    is_self_closing: bool    // e.g. <br/>, <input/>
    attributes: Vector*      // Vector of HtmlAttribute*
    events: Vector*          // Vector of EventHandler*
    children: Vector*        // Vector of Element*
    style_obj: Style*        // Style object for inline styles

    // For TextNode / RawHtmlNode:
    text_content: string

    // For ComponentNode:
    component_name: string

    constructor() {
        self.kind = ElementKind.TagNode
        self.tag = ""
        self.is_self_closing = false
        self.attributes = vector_create(8)
        self.events = vector_create(4)
        self.children = vector_create(8)
        self.style_obj = null
        self.text_content = ""
        self.component_name = ""
    }

    // ---- Factories ----

    // Create a tag element
    static fn create_tag(string tag_name) Element {
        auto el = Element()
        el.kind = ElementKind.TagNode
        el.tag = string_create(tag_name)
        return el
    }

    // Create a text node
    static fn create_text(string text) Element {
        auto el = Element()
        el.kind = ElementKind.TextNode
        el.text_content = string_create(text)
        return el
    }

    // Create a raw HTML node (dangerously unescaped)
    static fn create_raw_html(string html) Element {
        auto el = Element()
        el.kind = ElementKind.RawHtmlNode
        el.text_content = string_create(html)
        return el
    }

    // ---- Mutators ----

    fn set_style(Style* s) Element {
        self.style_obj = s
        return self
    }

    fn add_class(string cls) Element {
        // Check if class attr exists
        auto existing = self.get_attribute("class")
        if (existing == null) {
            return self.set_attribute("class", cls)
        } else {
            auto sb = string_builder_create()
            string_builder_append(sb, existing.ptr)
            string_builder_append(sb, " ")
            string_builder_append(sb, cls.ptr)
            auto combined = string_builder_to_string(sb)
            string_builder_destroy(sb)
            return self.set_attribute("class", combined)
        }
    }

    fn set_id(string id) Element {
        return self.set_attribute("id", id)
    }

    fn set_attribute(string name, string value) Element {
        // Look for existing attribute with same name
        auto idx = self._find_attribute(name)
        auto name_copy = string_create(name)
        auto val_copy = string_create(value)
        if (idx >= 0) {
            auto attr = vector_get(self.attributes, idx): HtmlAttribute*
            if (attr != null) {
                attr.name = name_copy
                attr.value = val_copy
            }
        } else {
            // Allocate new HtmlAttribute
            auto attr = std.memory.std_malloc(sizeof(HtmlAttribute)): HtmlAttribute*
            attr.name = name_copy
            attr.value = val_copy
            vector_push_back(self.attributes, attr)
        }
        return self
    }

    fn set_data(string key, string value) Element {
        auto name = string_concat(string_wrap("data-"), string_wrap(key.ptr))
        return self.set_attribute(name, value)
    }

    fn set_aria(string key, string value) Element {
        auto name = string_concat(string_wrap("aria-"), string_wrap(key.ptr))
        return self.set_attribute(name, value)
    }

    fn get_attribute(string name) string {
        auto idx = self._find_attribute(name)
        if (idx < 0) return null: string
        auto attr = vector_get(self.attributes, idx): HtmlAttribute*
        if (attr == null) return null: string
        return attr.value
    }

    fn _find_attribute(string name) int {
        auto size = vector_size(self.attributes)
        for (auto i = 0; i < size; i++) {
            auto attr = vector_get(self.attributes, i): HtmlAttribute*
            if (attr != null) {
                if (strcmp(attr.name.ptr, name.ptr) == 0) {
                    return i
                }
            }
        }
        return -1
    }

    // ---- Event Attachment ----

    fn on(string event_name, string js_action) Element {
        auto ev = std.memory.std_malloc(sizeof(EventHandler)): EventHandler*
        ev.event_name = string_create(event_name)
        ev.action = string_create(js_action)
        vector_push_back(self.events, ev)
        return self
    }

    fn on_click(string js) Element { return self.on("click", js) }
    fn on_submit(string js) Element { return self.on("submit", js) }
    fn on_change(string js) Element { return self.on("change", js) }
    fn on_input(string js) Element { return self.on("input", js) }
    fn on_focus(string js) Element { return self.on("focus", js) }
    fn on_blur(string js) Element { return self.on("blur", js) }
    fn on_hover(string js) Element { return self.on("mouseenter", js) }
    fn on_leave(string js) Element { return self.on("mouseleave", js) }
    fn on_load(string js) Element { return self.on("load", js) }
    fn on_submit_post(string endpoint) Element {
        // Build a POST form submit handler via fetch
        auto sb = string_builder_create()
        string_builder_append(sb, "event.preventDefault(); fetch('")
        string_builder_append(sb, endpoint.ptr)
        string_builder_append(sb, "',{method:'POST',body:new FormData(this)}).then(r=>r.text()).then(r=>{document.open();document.write(r);document.close();});")
        auto js = string_builder_to_string(sb)
        string_builder_destroy(sb)
        return self.on("submit", js)
    }

    // ---- Child Management ----

    fn append_child(Element* child) Element {
        if (child != null) {
            vector_push_back(self.children, child)
        }
        return self
    }

    fn append(Element* child) Element {
        return self.append_child(child)
    }

    fn add_children(Vector* more_children) Element {
        if (more_children == null) return self
        auto n = vector_size(more_children)
        for (auto i = 0; i < n; i++) {
            auto c = vector_get(more_children, i): Element*
            if (c != null) vector_push_back(self.children, c)
        }
        return self
    }

    fn text(string t) Element {
        return self.append_child(&Element.create_text(t))
    }

    fn html(string raw) Element {
        return self.append_child(&Element.create_raw_html(raw))
    }

    // ---- Rendering ----

    fn render() string {
        auto sb = string_builder_create()
        self.render_into(sb)
        auto result = string_builder_to_string(sb)
        string_builder_destroy(sb)
        return result
    }

    fn render_into(StringBuilder* sb) void {
        match self.kind {
            ElementKind.TagNode => self._render_tag(sb),
            ElementKind.TextNode => self._render_text(sb),
            ElementKind.RawHtmlNode => self._render_raw(sb),
            ElementKind.ComponentNode => self._render_component(sb),
        }
    }

    fn _render_text(StringBuilder* sb) void {
        // Escape for safety
        auto escaped = self._escape_html(self.text_content)
        string_builder_append(sb, escaped.ptr)
    }

    fn _render_raw(StringBuilder* sb) void {
        string_builder_append(sb, self.text_content.ptr)
    }

    fn _render_component(StringBuilder* sb) void {
        string_builder_append(sb, "<!-- Component: ")
        string_builder_append(sb, self.component_name.ptr)
        string_builder_append(sb, " -->")
    }

    fn _render_tag(StringBuilder* sb) void {
        string_builder_append_char(sb, '<')
        string_builder_append(sb, self.tag.ptr)

        // id attribute from style_obj takes precedence
        if (self.style_obj != null && self.style_obj.id.len > 0) {
            string_builder_append(sb, " id=\"")
            string_builder_append(sb, self.style_obj.id.ptr)
            string_builder_append_char(sb, '"')
        }

        // class attribute: combine from style_obj + set_attribute("class")
        auto class_parts = string_builder_create()
        if (self.style_obj != null && self.style_obj.class_name.len > 0) {
            string_builder_append(class_parts, self.style_obj.class_name.ptr)
        }
        auto explicit_class = self.get_attribute("class")
        if (explicit_class.len > 0) {
            if (string_builder_to_string(class_parts).len > 0) {
                string_builder_append_char(class_parts, ' ')
            }
            string_builder_append(class_parts, explicit_class.ptr)
        }
        auto combined_class = string_builder_to_string(class_parts)
        if (combined_class.len > 0) {
            string_builder_append(sb, " class=\"")
            string_builder_append(sb, combined_class.ptr)
            string_builder_append_char(sb, '"')
        }
        string_builder_destroy(class_parts)

        // Regular attributes (skip "class" and "id" if already set)
        auto attr_count = vector_size(self.attributes)
        for (auto i = 0; i < attr_count; i++) {
            auto attr = vector_get(self.attributes, i): HtmlAttribute*
            if (attr == null) continue
            // Skip id and class as handled specially
            if (strcmp(attr.name.ptr, "id") == 0 && self.style_obj != null && self.style_obj.id.len > 0) continue
            if (strcmp(attr.name.ptr, "class") == 0) continue

            string_builder_append_char(sb, ' ')
            string_builder_append(sb, attr.name.ptr)
            string_builder_append(sb, "=\"")
            auto escaped_val = self._escape_html(attr.value)
            string_builder_append(sb, escaped_val.ptr)
            string_builder_append_char(sb, '"')
        }

        // Events as inline onXXX handlers
        auto ev_count = vector_size(self.events)
        for (auto i = 0; i < ev_count; i++) {
            auto ev = vector_get(self.events, i): EventHandler*
            if (ev == null) continue
            string_builder_append_char(sb, ' ')
            string_builder_append(sb, "on")
            string_builder_append(sb, ev.event_name.ptr)
            string_builder_append(sb, "=\"")
            string_builder_append(sb, ev.action.ptr)
            string_builder_append_char(sb, '"')
        }

        // Inline style attribute
        if (self.style_obj != null) {
            auto inline_style = self.style_obj.build_inline()
            if (inline_style.len > 0) {
                string_builder_append_char(sb, ' ')
                string_builder_append(sb, inline_style.ptr)
            }
        }

        // Self-closing
        if (self.is_self_closing) {
            string_builder_append(sb, " />")
            return
        }

        string_builder_append_char(sb, '>')

        // Children
        auto child_count = vector_size(self.children)
        for (auto i = 0; i < child_count; i++) {
            auto child = vector_get(self.children, i): Element*
            if (child != null) {
                child.render_into(sb)
            }
        }

        // Close tag
        string_builder_append(sb, "</")
        string_builder_append(sb, self.tag.ptr)
        string_builder_append_char(sb, '>')
    }

    fn _escape_html(string s) string {
        if (s.len == 0) return s
        // Simple conservative escaping via string replacement
        auto result = s
        result = string_replace_string(result, string_wrap("&"), string_wrap("&amp;"))
        result = string_replace_string(result, string_wrap("<"), string_wrap("&lt;"))
        result = string_replace_string(result, string_wrap(">"), string_wrap("&gt;"))
        result = string_replace_string(result, string_wrap("\""), string_wrap("&quot;"))
        result = string_replace_string(result, string_wrap("'"), string_wrap("&#39;"))
        return result
    }
}

// ============================================================
// Convenience Constructors (HTML tags)
// ============================================================

// === Document structure ===

fn doctype() Element {
    return Element.create_raw_html("<!DOCTYPE html>\n")
}

fn html_tag() Element { return Element.create_tag("html") }
fn head_tag() Element { return Element.create_tag("head") }
fn body_tag() Element { return Element.create_tag("body") }
fn meta_(string name, string content) Element {
    auto el = Element.create_tag("meta")
    el.is_self_closing = true
    el.set_attribute("name", name)
    el.set_attribute("content", content)
    return el
}
fn meta_charset(string charset) Element {
    auto el = Element.create_tag("meta")
    el.is_self_closing = true
    el.set_attribute("charset", charset)
    return el
}
fn title_(string text) Element {
    return Element.create_tag("title").text(text)
}
fn link_css(string href) Element {
    auto el = Element.create_tag("link")
    el.is_self_closing = true
    el.set_attribute("rel", "stylesheet")
    el.set_attribute("href", href)
    return el
}
fn script_src(string src) Element {
    auto el = Element.create_tag("script")
    el.set_attribute("src", src)
    return el
}
fn script_inline(string js) Element {
    return Element.create_tag("script").html(js)
}
fn style_tag(string css) Element {
    return Element.create_tag("style").html(css)
}
fn base_(string href) Element {
    auto el = Element.create_tag("base")
    el.is_self_closing = true
    el.set_attribute("href", href)
    return el
}

// === Sections ===

fn div() Element { return Element.create_tag("div") }
fn section() Element { return Element.create_tag("section") }
fn article() Element { return Element.create_tag("article") }
fn aside() Element { return Element.create_tag("aside") }
fn header() Element { return Element.create_tag("header") }
fn footer() Element { return Element.create_tag("footer") }
fn nav_tag() Element { return Element.create_tag("nav") }
fn main_tag() Element { return Element.create_tag("main") }
fn span() Element { return Element.create_tag("span") }
fn p_tag() Element { return Element.create_tag("p") }
fn br_() Element {
    auto el = Element.create_tag("br")
    el.is_self_closing = true
    return el
}
fn hr_() Element {
    auto el = Element.create_tag("hr")
    el.is_self_closing = true
    return el
}

// === Headings ===

fn h1() Element { return Element.create_tag("h1") }
fn h2() Element { return Element.create_tag("h2") }
fn h3() Element { return Element.create_tag("h3") }
fn h4() Element { return Element.create_tag("h4") }
fn h5() Element { return Element.create_tag("h5") }
fn h6() Element { return Element.create_tag("h6") }

// === Inline ===

fn a_tag(string href) Element {
    auto el = Element.create_tag("a")
    el.set_attribute("href", href)
    return el
}
fn strong() Element { return Element.create_tag("strong") }
fn em_tag() Element { return Element.create_tag("em") }
fn b_tag() Element { return Element.create_tag("b") }
fn i_tag() Element { return Element.create_tag("i") }
fn u_tag() Element { return Element.create_tag("u") }
fn small() Element { return Element.create_tag("small") }
fn sub_() Element { return Element.create_tag("sub") }
fn sup_() Element { return Element.create_tag("sup") }
fn mark() Element { return Element.create_tag("mark") }
fn code() Element { return Element.create_tag("code") }
fn pre() Element { return Element.create_tag("pre") }
fn blockquote() Element { return Element.create_tag("blockquote") }
fn cite() Element { return Element.create_tag("cite") }
fn abbr(string title) Element {
    return Element.create_tag("abbr").set_attribute("title", title)
}

// === Lists ===

fn ul() Element { return Element.create_tag("ul") }
fn ol() Element { return Element.create_tag("ol") }
fn li() Element { return Element.create_tag("li") }
fn dl() Element { return Element.create_tag("dl") }
fn dt() Element { return Element.create_tag("dt") }
fn dd() Element { return Element.create_tag("dd") }

// === Forms ===

fn form_tag(string method, string action) Element {
    auto el = Element.create_tag("form")
    el.set_attribute("method", method)
    el.set_attribute("action", action)
    return el
}
fn form_post(string action) Element { return form_tag("POST", action) }
fn form_get(string action) Element { return form_tag("GET", action) }

fn input_(string type) Element {
    auto el = Element.create_tag("input")
    el.is_self_closing = true
    el.set_attribute("type", type)
    return el
}
fn input_text(string name) Element { return input_("text").set_attribute("name", name) }
fn input_email(string name) Element { return input_("email").set_attribute("name", name) }
fn input_password(string name) Element { return input_("password").set_attribute("name", name) }
fn input_number(string name) Element { return input_("number").set_attribute("name", name) }
fn input_hidden(string name, string value) Element {
    return input_("hidden").set_attribute("name", name).set_attribute("value", value)
}
fn input_submit(string value) Element {
    return input_("submit").set_attribute("value", value)
}
fn input_checkbox(string name, string value) Element {
    return input_("checkbox").set_attribute("name", name).set_attribute("value", value)
}
fn input_radio(string name, string value) Element {
    return input_("radio").set_attribute("name", name).set_attribute("value", value)
}
fn input_file(string name) Element { return input_("file").set_attribute("name", name) }
fn input_date(string name) Element { return input_("date").set_attribute("name", name) }
fn input_time(string name) Element { return input_("time").set_attribute("name", name) }
fn input_color(string name) Element { return input_("color").set_attribute("name", name) }

fn textarea(string name, int rows, int cols) Element {
    auto el = Element.create_tag("textarea")
    el.set_attribute("name", name)
    el.set_attribute("rows", string_create_from_int(rows))
    el.set_attribute("cols", string_create_from_int(cols))
    return el
}

fn button_(string type) Element {
    auto el = Element.create_tag("button")
    el.set_attribute("type", type)
    return el
}
fn button_submit() Element { return button_("submit") }
fn button_reset() Element { return button_("reset") }
fn button_generic() Element { return button_("button") }

fn label_for(string for_id) Element {
    return Element.create_tag("label").set_attribute("for", for_id)
}
fn select_(string name) Element {
    return Element.create_tag("select").set_attribute("name", name)
}
fn option_(string value, string label) Element {
    return Element.create_tag("option").set_attribute("value", value).text(label)
}
fn option_selected(string value, string label) Element {
    auto el = option_(value, label)
    el.set_attribute("selected", "selected")
    return el
}
fn optgroup(string label) Element {
    return Element.create_tag("optgroup").set_attribute("label", label)
}
fn fieldset() Element { return Element.create_tag("fieldset") }
fn legend(string text) Element { return Element.create_tag("legend").text(text) }

// === Table ===

fn table() Element { return Element.create_tag("table") }
fn thead() Element { return Element.create_tag("thead") }
fn tbody() Element { return Element.create_tag("tbody") }
fn tfoot() Element { return Element.create_tag("tfoot") }
fn tr() Element { return Element.create_tag("tr") }
fn th() Element { return Element.create_tag("th") }
fn td() Element { return Element.create_tag("td") }
fn caption(string text) Element { return Element.create_tag("caption").text(text) }

// === Media / Embedded ===

fn img_(string src, string alt) Element {
    auto el = Element.create_tag("img")
    el.is_self_closing = true
    el.set_attribute("src", src)
    el.set_attribute("alt", alt)
    return el
}
fn svg_tag(string viewBox) Element {
    return Element.create_tag("svg").set_attribute("viewBox", viewBox)
}
fn canvas(string id) Element {
    return Element.create_tag("canvas").set_id(id)
}
fn audio_tag(string src) Element {
    return Element.create_tag("audio").set_attribute("src", src)
}
fn video_tag(string src) Element {
    return Element.create_tag("video").set_attribute("src", src)
}
fn source_(string src, string type) Element {
    auto el = Element.create_tag("source")
    el.is_self_closing = true
    el.set_attribute("src", src)
    el.set_attribute("type", type)
    return el
}
fn iframe(string src) Element {
    return Element.create_tag("iframe").set_attribute("src", src)
}

// === Misc ===

fn figure() Element { return Element.create_tag("figure") }
fn figcaption() Element { return Element.create_tag("figcaption") }
fn details() Element { return Element.create_tag("details") }
fn summary(string text) Element { return Element.create_tag("summary").text(text) }
fn dialog() Element { return Element.create_tag("dialog") }
fn noscript() Element { return Element.create_tag("noscript") }
fn template_tag() Element { return Element.create_tag("template") }
